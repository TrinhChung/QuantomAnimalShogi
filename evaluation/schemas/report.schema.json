{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qas.local/schemas/report.schema.json",
  "title": "Completed evaluation result manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "complete", "classification", "report_path"],
  "properties": {
    "schema_version": {"const": 1},
    "complete": {"const": true},
    "classification": {
      "enum": [
        "ACCEPT_STRENGTH_UPGRADE", "ACCEPT_PERFORMANCE_UPGRADE",
        "ACCEPT_EQUIVALENT_REPLACEMENT", "REJECT_CORRECTNESS",
        "REJECT_RELIABILITY", "REJECT_PERFORMANCE", "REJECT_STRENGTH", "INCONCLUSIVE"
      ]
    }
  },
  "additionalProperties": true
}
