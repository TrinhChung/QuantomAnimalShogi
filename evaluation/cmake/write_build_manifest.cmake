foreach(required QAS_EXE BENCHMARK_EXE REFEREE_EXE OUTPUT_FILE)
    if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
        message(FATAL_ERROR "Cannot write evaluation build manifest: ${required} is missing")
    endif()
endforeach()

file(SHA256 "${QAS_EXE}" QAS_SHA256)
file(SHA256 "${BENCHMARK_EXE}" BENCHMARK_SHA256)
file(SHA256 "${REFEREE_EXE}" REFEREE_SHA256)
string(TIMESTAMP GENERATED_AT_UTC "%Y-%m-%dT%H:%M:%SZ" UTC)

foreach(value BUILD_CONFIGURATION COMPILER_ID COMPILER_VERSION GIT_COMMIT GIT_DIRTY)
    if(NOT DEFINED ${value})
        set(${value} "unknown")
    endif()
    string(REPLACE "\\" "\\\\" ${value} "${${value}}")
    string(REPLACE "\"" "\\\"" ${value} "${${value}}")
endforeach()

file(WRITE "${OUTPUT_FILE}" "{\n")
file(APPEND "${OUTPUT_FILE}" "  \"schema_version\": 1,\n")
file(APPEND "${OUTPUT_FILE}" "  \"generated_at_utc\": \"${GENERATED_AT_UTC}\",\n")
file(APPEND "${OUTPUT_FILE}" "  \"build_configuration\": \"${BUILD_CONFIGURATION}\",\n")
file(APPEND "${OUTPUT_FILE}" "  \"compiler_id\": \"${COMPILER_ID}\",\n")
file(APPEND "${OUTPUT_FILE}" "  \"compiler_version\": \"${COMPILER_VERSION}\",\n")
file(APPEND "${OUTPUT_FILE}" "  \"git_commit\": \"${GIT_COMMIT}\",\n")
file(APPEND "${OUTPUT_FILE}" "  \"git_dirty_at_configure\": \"${GIT_DIRTY}\",\n")
file(APPEND "${OUTPUT_FILE}" "  \"qas_sha256\": \"${QAS_SHA256}\",\n")
file(APPEND "${OUTPUT_FILE}" "  \"benchmark_sha256\": \"${BENCHMARK_SHA256}\",\n")
file(APPEND "${OUTPUT_FILE}" "  \"referee_sha256\": \"${REFEREE_SHA256}\"\n")
file(APPEND "${OUTPUT_FILE}" "}\n")
